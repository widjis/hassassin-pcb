{
  "name": "hassassin-ai-pcb-designer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hassassin/web dev",
    "build": "pnpm --filter @hassassin/web build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hassassin": "node apps/cli/bin/hassassin.mjs",
    "server": "node --env-file-if-exists=.env apps/server/src/main.ts --data .data",
    "start": "pnpm build && node --env-file-if-exists=.env apps/server/src/main.ts --data .data --static apps/web/dist"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "js-angusj-clipper": "1.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.23.0"
}
